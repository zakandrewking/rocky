{
  "name": "rocky",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "pnpm --filter @rocky/desktop dev",
    "build": "pnpm --filter @rocky/desktop build",
    "dist:mac": "pnpm --filter @rocky/desktop dist:mac",
    "lint": "pnpm --filter @rocky/desktop lint",
    "test": "pnpm --filter @rocky/desktop test",
    "typecheck": "pnpm --filter @rocky/desktop typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
