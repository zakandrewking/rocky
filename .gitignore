.env
.DS_Store
node_modules/
.pnpm-store/
local-data/
dist/
out/
release/
coverage/
*.log
__pycache__/
*.py[cod]

# Firmware dumps: multi-MB binaries, and the only path back to stock CyberOS.
# Never committed, never deleted.
apps/cyberpi/firmware/backups/

# PlatformIO build output - regenerated locally, not portable between machines.
apps/cyberpi/.pio/

# Generated from the repo root .env at build time - contains the real Wi-Fi
# password, never committed.
apps/cyberpi/src/wifi_credentials.h

.pocketbot

# Generated by `xcodegen generate` from apps/ios/project.yml -- regenerate, don't commit,
# same reasoning as not committing node_modules.
apps/ios/*.xcodeproj/
apps/ios/Generated/
apps/ios/build/

# Generated at build time by apps/ios/scripts/generate.sh, from
# services/device-api/src/session.ts -- keeps Rocky's persona defined in exactly one place
# in the repo (see session.ts's own header comment) instead of a hand-copied Swift literal.
apps/ios/Rocky/Resources/RealtimeSessionConfig.json
