OPENAI_API_KEY=your_openai_api_key_here
# Also baked directly into apps/ios's Info.plist at build time (apps/ios/scripts/generate.sh) so
# the phone can mint its own Realtime secret with no laptop server involved -- a personal-device
# tradeoff, since that key is then on the phone unscoped. See apps/ios/README.md.
# Optional Hume Octave voice-design audition (kept in Electron main/local scripts only):
# HUME_API_KEY=your_hume_api_key_here
# HUME_VOICE_ID=your_private_saved_voice_id
# HUME_VOICE_NAME=Rocky Original
# HUME_VOICE_DESCRIPTION=An original adult male alien engineer...
# ROCKY_HUME_EXTRA_DELAY_MS=0
# Optional robot-body backend (services/device-api) -- mints ephemeral OpenAI client secrets for
# devices that must never hold the real key (e.g. the CyberPi body itself). apps/ios's Realtime
# voice does NOT use this -- it bakes OPENAI_API_KEY in directly instead, see above.
# Comma-separated deviceId:token pairs; tokens must be at least 16 characters. Generate one
# with `openssl rand -hex 24`. While unset, the probe endpoints stay open and
# /v1/device/session refuses to mint anything.
# ROCKY_DEVICE_TOKENS=rocky-mbot2:generate_a_long_random_token
# ROCKY_DEVICE_API_PORT=8787
# ROCKY_DEVICE_API_HOST=0.0.0.0
# Wi-Fi the CyberPi's native firmware joins for OTA (apps/cyberpi). Read at
# PlatformIO build time into a gitignored header - never committed, never
# baked into a committed sdkconfig.
# CYBERPI_WIFI_SSID=your_wifi_network_name
# CYBERPI_WIFI_PASSWORD=your_wifi_password
# Optional overrides (also read by apps/ios/scripts/dump-session-config.mjs at build time):
# ROCKY_REALTIME_MODEL=gpt-realtime-2.1
# ROCKY_VOICE=cedar
# ROCKY_RESEARCH_MODEL=gpt-5.5
# ROCKY_RESEARCH_TIMEOUT_MS=60000
# ROCKY_RESEARCH_REASONING_EFFORT=low
# ROCKY_RESEARCH_MAX_OUTPUT_TOKENS=900
# ROCKY_ALIEN_VOICE=1
# ROCKY_ALIEN_VOICE_VOLUME=0.045
# ROCKY_ALIEN_VOICE_TIME_SCALE=0.68
