OPENAI_API_KEY=your_openai_api_key_here
# Optional Hume Octave voice-design audition (kept in Electron main/local scripts only):
# HUME_API_KEY=your_hume_api_key_here
# HUME_VOICE_ID=your_private_saved_voice_id
# HUME_VOICE_NAME=Rocky Original
# HUME_VOICE_DESCRIPTION=An original adult male alien engineer...
# ROCKY_HUME_EXTRA_DELAY_MS=0
# Optional CyberPi robot backend (services/device-api). Comma-separated
# deviceId:token pairs; tokens must be at least 16 characters. Generate one with
# `openssl rand -hex 24`. While unset, the probe endpoints stay open and
# /v1/device/session refuses to mint anything.
# ROCKY_DEVICE_TOKENS=rocky-mbot2:generate_a_long_random_token
# ROCKY_DEVICE_API_PORT=8787
# ROCKY_DEVICE_API_HOST=0.0.0.0
# Optional overrides:
# ROCKY_REALTIME_MODEL=gpt-realtime-2.1
# ROCKY_VOICE=cedar
# ROCKY_RESEARCH_MODEL=gpt-5.5
# ROCKY_RESEARCH_TIMEOUT_MS=60000
# ROCKY_RESEARCH_REASONING_EFFORT=low
# ROCKY_RESEARCH_MAX_OUTPUT_TOKENS=900
# ROCKY_ALIEN_VOICE=1
# ROCKY_ALIEN_VOICE_VOLUME=0.045
# ROCKY_ALIEN_VOICE_TIME_SCALE=0.68
